# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.venv-*/

# Deployment secrets: the compose stack reads this, deploy/.env.example is the
# tracked template.
deploy/.env
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Never commit data or model weights. The nnU-Net roots and run directories can
# reach hundreds of GB; see README for where they belong.
nnUNet_raw/
nnUNet_preprocessed/
nnUNet_results/
runs/
*.nii
*.nii.gz
*.npz
*.npy
*.b2nd
*.pth
*.pkl

# Local machine-specific config (paths, hosts). configs/dataset.yaml is the
# tracked template; dataset.local.yaml is yours and is ignored.
configs/dataset.local.yaml
configs/*.local.yaml

# Editors / OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# Server access. `.secrets/` is yours and never leaves this machine; the tracked
# template is .secrets/server.env.example. Ignored as a whole directory rather
# than by filename, so a second credentials file dropped in beside it is covered
# too -- the usual way a secret reaches a public repository is a name nobody
# thought to add.
# Files inside, not the directory itself: git cannot re-include anything under
# an excluded *directory*, so `.secrets/` plus a negation would silently ignore
# the template too.
.secrets/*
!.secrets/server.env.example
