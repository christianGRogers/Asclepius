# Server access for scripts/server-run.py. Copy to `server.env` and fill in.
#
#     cp .secrets/server.env.example .secrets/server.env
#     chmod 600 .secrets/server.env          # or on Windows, leave it; the
#                                            # directory is already per-user
#
# `.secrets/` is in .gitignore, so nothing here is committed. This file -- the
# example, with no real values -- is the only one tracked.
#
# Prefer a key over a password if you have one: a key cannot be replayed from a
# log, and it is the difference between revoking one machine's access and
# changing a password every service on the box shares.

SSH_HOST=testservera.example.net
SSH_PORT=22
SSH_USERNAME=christian

# One of these two. Leave the other blank.
SSH_PASSWORD=
SSH_KEY_PATH=

# Only if sudo needs a password and it differs from SSH_PASSWORD. Blank means
# "reuse SSH_PASSWORD", which is the usual case.
SUDO_PASSWORD=

# Where the SegQueue checkout lives on that machine, if you already know it.
# Blank is fine -- server-run.py can be pointed anywhere, and the deploy
# workflow finds it for itself.
SEGQUEUE_DIR=
