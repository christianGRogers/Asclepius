# Copy to `.env` and edit. `docker compose` reads it automatically.

# Public name of the server. A hostname gets a real Let's Encrypt certificate;
# an `https://<ip>` here gets a self-signed one instead (fine behind a VPN).
SEGQUEUE_DOMAIN=segqueue.example.edu

# Where Let's Encrypt sends expiry warnings. Leave blank for the self-signed path.
SEGQUEUE_TLS_EMAIL=you@example.edu

# Everything that must survive a rebuild lives under here: the Mongo data files
# and the Girder assetstore. Put it on the RAID1/ZFS mirror, not the system disk.
# Budget ~1.5 TB for 5,000 CTs plus their segmentations.
DATA_ROOT=/srv/segqueue

# Optional: a read-only mount of the de-identified CTs waiting to be ingested.
# Mounted at /incoming inside the girder container, where segqueue-ingest reads it.
CASE_SOURCE_ROOT=/srv/incoming

# WiredTiger cache. Roughly a quarter of system RAM, leaving room for Girder and
# the page cache that is doing the real work on a file-heavy workload.
MONGO_CACHE_GB=2
