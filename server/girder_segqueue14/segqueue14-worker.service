# SegQueue14's scoring worker: per-class ImageCAS-X and two-read scores, and the
# SegQueue14 lease sweep. Independent of segqueue-worker.service -- stopping or
# removing this one leaves the live worker running, and vice versa.
#
#   sudo cp server/girder_segqueue14/segqueue14-worker.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now segqueue14-worker
[Unit]
Description=SegQueue14 scoring worker
Requires=segqueue-mongod.service
After=segqueue-mongod.service segqueue-girder.service

[Service]
Type=simple
User=christian
Group=christian
WorkingDirectory=/home/christian/Asclepius
Environment=GIRDER_MONGO_URI=mongodb://127.0.0.1:27017/girder
Environment=GIRDER_SERVER_MODE=production
ExecStart=/home/christian/Asclepius/.venv/bin/segqueue14-score --poll 30 --sweep 3600
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
