#!/bin/bash
# Crucible GPU experiment for the plan tournament: how to train on TWO reads per case (decision D2).
# Usage (contract): cd <root>/experiments/crucible && ./crucible
# Optional: ./crucible status | ./crucible collect | ./crucible dryrun   (dryrun: everything except building the venv
# and sbatch; prints the sbatch command). CASES=/path overrides case discovery; ACCOUNT=<acct> overrides the default --account=def-aso22.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CMD="${1:-run}"
NAME=crucible_2reads
WORK="${CRUCIBLE_WORK:-${SCRATCH:-/tmp}/$NAME}"
VENV="${CRUCIBLE_VENV:-$HOME/.venvs/crucible}"
export CRUCIBLE_WORK="$WORK" CRUCIBLE_HERE="$HERE" CRUCIBLE_VENV="$VENV"

say() { printf '[crucible] %s\n' "$*"; }
die() { printf '[crucible] ERROR: %s\n' "$*" >&2; exit 1; }

collect() {
  if [ -f "$WORK/results/SUMMARY.md" ]; then
    mkdir -p "$HERE/results" && cp -r "$WORK/results/." "$HERE/results/"
    say "results copied to $HERE/results (SUMMARY.md, results.json, logs/)"; return 0
  fi
  return 1
}

running_job() { command -v squeue >/dev/null && squeue -h -u "$USER" --name "$NAME" -o '%i %T' 2>/dev/null | head -n1; }

case "$CMD" in
  status)
    j="$(running_job || true)"
    if [ -n "$j" ]; then say "job: $j"; else say "no job in the queue"; fi
    [ -f "$WORK/state.json" ] && cat "$WORK/state.json"; exit 0 ;;
  collect) collect || die "no results yet in $WORK/results"; exit 0 ;;
  run|dryrun) ;;
  *) die "unknown command '$CMD' (use: run | status | collect | dryrun)" ;;
esac

# GPU jobs must be submitted from the GPU login node (Trillium quickstart); hop there if we are on a CPU login node.
if [ "$CMD" = run ] && command -v sbatch >/dev/null && [[ "$(hostname -s)" != trig-* ]] && [ -z "${CRUCIBLE_NO_HOP:-}" ]; then
  say "not on the GPU login node ($(hostname -s)); re-running on trig-login01"
  exec ssh trig-login01 "cd '$HERE' && CRUCIBLE_NO_HOP=1 CASES='${CASES:-}' ACCOUNT='${ACCOUNT:-${CRUCIBLE_ACCOUNT:-}}' ./crucible run"
fi

mkdir -p "$WORK/logs"
collect && { [ -f "$WORK/state.json" ] && grep -q '"eval": true' "$WORK/state.json" && \
  ! grep -q unfinished_ "$WORK/state.json" && { say "experiment complete; nothing to do"; exit 0; }; } || true

j="$(running_job || true)"
[ -n "$j" ] && { say "already queued/running: $j -- not submitting again. './crucible status' to check."; exit 0; }

# 1. environment (login node: internet available here, not on compute nodes)
if [ "$CMD" = run ]; then
  if command -v module >/dev/null 2>&1 || [ -n "${MODULESHOME:-}" ]; then
    # shellcheck disable=SC1091
    [ -n "${MODULESHOME:-}" ] && source "$MODULESHOME/init/bash" 2>/dev/null || true
    module purge; module load StdEnv/2023 python/3.11.5 cuda/12.6
  fi
  if [ ! -f "$VENV/.ok" ]; then
    say "building venv $VENV"
    if command -v virtualenv >/dev/null; then virtualenv --no-download "$VENV"; else python3 -m venv "$VENV"; fi
    # shellcheck disable=SC1091
    source "$VENV/bin/activate"
    pip install --no-index --upgrade pip || pip install --upgrade pip
    pip install --no-index torch || pip install torch
    pip install --no-index nnunetv2==2.8.1 SimpleITK nibabel scikit-image scipy || \
      pip install nnunetv2==2.8.1 SimpleITK nibabel scikit-image scipy
    touch "$VENV/.ok"
  fi
  # shellcheck disable=SC1091
  source "$VENV/bin/activate"
  PY=python
else
  PY="${PYTHON:-python3}"
fi
TRDIR="$($PY -c 'import nnunetv2, os; print(os.path.join(os.path.dirname(nnunetv2.__file__), "training", "nnUNetTrainer"))')"
if [ "$CMD" = run ]; then cp "$HERE/lib/nnUNetTrainerCrucible.py" "$TRDIR/"; fi
$PY -c 'import torch, nnunetv2, nibabel, skimage, scipy; print("python env ok: torch", torch.__version__)'

# 2. cases (walk up to the first cases/ directory) and ImageCAS-X labels (Zenodo, one HTTP range request)
$PY "$HERE/lib/discover.py" "$HERE" "$WORK/manifest.json" || die "case discovery failed (see above)"
$PY "$HERE/lib/fetch_icx.py" "$WORK/icx"

# 3. submit (one job, 1 x H100, 23 h 55 min: the whole 24 h budget; re-running resumes unfinished stages)
# Trillium account (project lead: def-aso22 is the only allocation). ACCOUNT= or CRUCIBLE_ACCOUNT= overrides.
ACC=(--account="${ACCOUNT:-${CRUCIBLE_ACCOUNT:-def-aso22}}")
# shellcheck disable=SC2054  # the comma list is sbatch's --export syntax, not an array separator
SB=(sbatch --parsable "${ACC[@]}" --output="$WORK/logs/%x_%j.out" --chdir="$WORK"
    --export=ALL,CRUCIBLE_WORK="$WORK",CRUCIBLE_HERE="$HERE",CRUCIBLE_VENV="$VENV" "$HERE/lib/job.sh")
if [ "$CMD" = dryrun ] || ! command -v sbatch >/dev/null; then
  say "dry run / no sbatch here; would submit:"; printf '  %q' "${SB[@]}"; echo; exit 0
fi
jid="$("${SB[@]}")"
say "submitted job $jid ($NAME, 1 x H100, 23:55:00). Logs: $WORK/logs/${NAME}_$jid.out"
say "results will appear in $WORK/results (copied to $HERE/results when the job can write there; otherwise run './crucible collect')"
