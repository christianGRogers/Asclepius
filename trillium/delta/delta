#!/usr/bin/env bash
# Delta's Trillium experiment. Run with no arguments from <root>/experiments/delta:   ./delta
#
#   ./delta            set up (venv, ImageCAS-X labels), submit the GPU job, or report / collect
#   ./delta status     show job state and progress
#   ./delta collect    copy finished results into ./results
#   ./delta dryrun     everything except sbatch (prints the job script)
#   ./delta smoke      CPU smoke test of the whole pipeline on a few cases (no SLURM, no modules)
#
# What it does: trains one 4-class nnU-Net on the decided thick convention and tests, on the 160
# ImageCAS-X test cases, whether gap-centred re-inference + support-gated bridging (P1') beats
# nnU-Net's default inference by tree-F1 @ 1.5 mm, with the tile-step-0.5 control. See README.md.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CMD="${1:-run}"
JOBNAME=delta_p1
PY_MODULES="StdEnv/2023 python/3.11.5"
GPU_MODULES="cuda/12.6"
BUDGET_S=$((24 * 3600))
USER="${USER:-$(id -un)}"

die() { echo "delta: ERROR: $*" >&2; exit 1; }
say() { echo "delta: $*"; }

# ---------------------------------------------------------------- find cases/ by walking up
find_cases() {
  if [[ -n "${CASES:-}" ]]; then echo "$CASES"; return; fi
  local d="$HERE"
  while [[ "$d" != "/" ]]; do
    if [[ -d "$d/cases" ]]; then echo "$d/cases"; return; fi
    d="$(dirname "$d")"
  done
  return 1
}
CASES_DIR="$(find_cases)" || die "no 'cases/' directory found in any parent of $HERE (looked up to /). Set CASES=/path to override."
CASES_DIR="$(cd "$CASES_DIR" && pwd)"

# ---------------------------------------------------------------- smoke test (local CPU)
if [[ "$CMD" == smoke ]]; then
  export DELTA_WORK="${DELTA_WORK:-$HERE/smoke_work}"
  export DELTA_CASES="$CASES_DIR" DELTA_SMOKE=1 DELTA_DEVICE=cpu DELTA_NPROC="${DELTA_NPROC:-2}" DELTA_EPOCHS=1
  export DELTA_ICX="${DELTA_ICX:-$DELTA_WORK/icx}"
  mkdir -p "$DELTA_WORK"
  python3 "$HERE/layout.py" "$CASES_DIR"
  # fetch_icx.py is idempotent and fails unless all 800 segmentations are present: always run it
  # (a test.txt-only guard let an interrupted fetch through and silently dropped 17 cases, Round 5)
  python3 "$HERE/fetch_icx.py" "$DELTA_ICX"
  python3 - <<EOF
import os, nnunetv2, shutil
d = os.path.join(os.path.dirname(nnunetv2.__file__), 'training', 'nnUNetTrainer', 'variants', 'delta')
os.makedirs(d, exist_ok=True); open(os.path.join(d, '__init__.py'), 'a').close()
shutil.copy('$HERE/nnUNetTrainerDelta.py', d)
EOF
  python3 "$HERE/pipeline.py" all
  mkdir -p "$HERE/results_smoke"; cp "$DELTA_WORK/results/"* "$HERE/results_smoke/" 2>/dev/null || true
  say "smoke test finished: $HERE/results_smoke"
  exit 0
fi

# ---------------------------------------------------------------- cluster side
[[ -n "${SCRATCH:-}" ]] || die "\$SCRATCH is not set: this must run on Trillium (or use ./delta smoke)."
case "$(hostname -s)" in
  trig-login*) ;;
  *)
    if [[ -z "${DELTA_NO_SSH:-}" && "$CMD" != dryrun ]]; then
      say "GPU jobs must be submitted from the GPU login node; re-running there (ssh trig-login01)."
      exec ssh trig-login01 "cd '$HERE' && CASES='$CASES_DIR' DELTA_NO_SSH=1 ./delta $CMD"
    fi ;;
esac

VENV="${DELTA_VENV:-$HOME/venvs/delta}"
LEDGER="$SCRATCH/delta_jobs.txt"      # walltime ledger shared by both modes (24 h budget in total)

# ---------------------------------------------------------------- mode (A13): Atlas's checkpoint, or our own model
# Round 3 ruling A13: Atlas's run goes first; when it has finished, this experiment runs inference
# only on Atlas's master-configuration checkpoint. If Atlas's run is still queued or running, wait.
# If Atlas has not been run at all, fall back to training our own ResEnc-L model.
ATLAS_W="${ATLAS_WORK:-$SCRATCH/atlas}"
ATLAS_HERE="$(cd "$HERE/.." && pwd)/atlas"
ATLAS_MODEL_DIR=""; ATLAS_CHK=""
find_atlas_model() {
  local m="$ATLAS_W/results/manifest.json" d c
  if [[ -f "$m" ]]; then
    d="$(python3 -c "import json,sys; j=json.load(open(sys.argv[1])); print(j.get('model_dir') or j.get('model_folder') or '')" "$m" 2>/dev/null || true)"
    c="$(python3 -c "import json,sys,os; j=json.load(open(sys.argv[1])); print(os.path.basename(j.get('checkpoint') or ''))" "$m" 2>/dev/null || true)"
    if [[ -n "$d" && -d "$d/fold_0" ]]; then ATLAS_MODEL_DIR="$d"; ATLAS_CHK="$c"; fi
  fi
  if [[ -z "$ATLAS_MODEL_DIR" ]]; then
    for d in "$ATLAS_W"/nnunet_results/Dataset713_AtlasProxy/nnUNetTrainerAtlas__*__3d_fullres; do
      [[ -d "$d/fold_0" ]] && ATLAS_MODEL_DIR="$d"
    done
  fi
  [[ -n "$ATLAS_MODEL_DIR" ]] || return 1
  if [[ -z "$ATLAS_CHK" || ! -f "$ATLAS_MODEL_DIR/fold_0/$ATLAS_CHK" ]]; then
    ATLAS_CHK=""
    for c in checkpoint_final.pth checkpoint_latest.pth checkpoint_best.pth; do
      if [[ -f "$ATLAS_MODEL_DIR/fold_0/$c" ]]; then ATLAS_CHK="$c"; break; fi
    done
  fi
  [[ -n "$ATLAS_CHK" ]]
}
MODE="${DELTA_FORCE_MODE:-}"
if [[ -z "$MODE" ]]; then
  if find_atlas_model && { [[ -e "$ATLAS_W/DONE" ]] || [[ -f "$ATLAS_W/results/manifest.json" ]]; }; then
    MODE=atlas
  elif squeue -u "$USER" -h -n atlas-r0r1 -o %i 2>/dev/null | grep -q .; then
    if [[ "$CMD" == run ]]; then
      say "Atlas's run (atlas-r0r1) is queued or running. A13: it goes first, and this experiment then runs"
      say "inference-only on its checkpoint. Nothing submitted; run ./delta again once Atlas has finished."
      exit 0
    fi
    MODE=atlas-pending
  else
    MODE=own
  fi
fi
if [[ "$MODE" == atlas ]]; then
  find_atlas_model || die "DELTA_FORCE_MODE=atlas but no Atlas checkpoint under $ATLAS_W"
  WORK="$SCRATCH/delta_exp_atlas"; JOBNAME=delta_p1_atlas
else
  WORK="$SCRATCH/delta_exp"
fi
mkdir -p "$WORK/logs" "$WORK/code"
say "cases: $CASES_DIR"
say "mode:  $MODE${ATLAS_MODEL_DIR:+ (Atlas model $ATLAS_MODEL_DIR, $ATLAS_CHK)}"
say "work:  $WORK   venv: $VENV"

load_modules() {
  if ! type module >/dev/null 2>&1; then
    # shellcheck disable=SC1091
    source /etc/profile >/dev/null 2>&1 || true
  fi
  type module >/dev/null 2>&1 || die "'module' command not available"
  module purge >/dev/null 2>&1 || true
  # shellcheck disable=SC2086
  module load $PY_MODULES
}

used_seconds() {
  local total=0 ids
  [[ -f "$LEDGER" ]] || { echo 0; return; }
  ids="$(paste -sd, "$LEDGER")"
  if command -v sacct >/dev/null 2>&1 && [[ -n "$ids" ]]; then
    while read -r s; do [[ "$s" =~ ^[0-9]+$ ]] && total=$((total + s)); done \
      < <(sacct -j "$ids" -X -n -o ElapsedRaw 2>/dev/null || true)
  fi
  echo "$total"
}

collect() {
  if [[ -f "$WORK/results/SUMMARY.md" ]]; then
    mkdir -p "$HERE/results"
    cp "$WORK/results/SUMMARY.md" "$WORK/results/results.json" "$HERE/results/" 2>/dev/null || true
    cp "$WORK/results/per_case.jsonl" "$HERE/results/" 2>/dev/null || true
    cp "$WORK/split.json" "$HERE/results/" 2>/dev/null || true
    mkdir -p "$HERE/results/logs"
    cp "$WORK"/logs/*.out "$HERE/results/logs/" 2>/dev/null || true
    find "$WORK/nnUNet_results" -name 'training_log_*.txt' -exec cp {} "$HERE/results/logs/" \; 2>/dev/null || true
    find "$WORK/nnUNet_results" -name 'progress.png' -exec cp {} "$HERE/results/logs/" \; 2>/dev/null || true
    say "results copied to $HERE/results ($(du -sh "$HERE/results" | cut -f1))"
    return 0
  fi
  return 1
}

running_job() { squeue -u "$USER" -h -n "$JOBNAME" -o '%i %T %M' 2>/dev/null || true; }

if [[ "$CMD" == status ]]; then
  r="$(running_job)"
  if [[ -n "$r" ]]; then say "job: $r"; else say "no $JOBNAME job in the queue"; fi
  say "used walltime so far: $(( $(used_seconds) / 60 )) min of $((BUDGET_S / 60))"
  find "$WORK" -maxdepth 1 -name '.done_*' -printf '  done: %f\n' 2>/dev/null || true
  [[ -f "$WORK/results/per_case.jsonl" ]] && say "evaluated case-bases: $(wc -l < "$WORK/results/per_case.jsonl")"
  last="$(find "$WORK/logs" -name '*.out' -printf '%T@ %p\n' 2>/dev/null | sort -n | tail -1 | cut -d' ' -f2-)"
  [[ -n "$last" ]] && tail -n 5 "$last"
  exit 0
fi
if [[ "$CMD" == collect ]]; then collect || die "no results yet in $WORK/results"; exit 0; fi

# ---------------------------------------------------------------- 1. results already there?
if [[ -f "$WORK/.done_summary" ]]; then collect; say "experiment finished; see $HERE/results/SUMMARY.md"; exit 0; fi

# ---------------------------------------------------------------- 2. job already queued/running?
if [[ "$CMD" != dryrun ]]; then
  r="$(running_job)"
  if [[ -n "$r" ]]; then say "a $JOBNAME job is already queued/running: $r  (./delta status)"; exit 0; fi
fi

# ---------------------------------------------------------------- 3. case layout
python3 "$HERE/layout.py" "$CASES_DIR" || die "case layout not recognised (see above)"

# ---------------------------------------------------------------- 4. venv (login node, once)
if [[ ! -f "$VENV/.delta_ok" ]]; then
  if [[ "$CMD" == dryrun ]]; then say "(dryrun) would build venv at $VENV"; else
    say "building venv $VENV (once; ~10 min)"
    load_modules
    rm -rf "$VENV"
    virtualenv --no-download "$VENV" 2>/dev/null || python -m venv "$VENV"
    # shellcheck disable=SC1091
    source "$VENV/bin/activate"
    pip install --no-index --upgrade pip >/dev/null 2>&1 || pip install --upgrade pip
    # Alliance wheelhouse first (built for the cluster), PyPI as fallback
    pip install --no-index torch 2>/dev/null || pip install torch
    pip install "nnunetv2==2.8.1" connected-components-3d remotezip scikit-image networkx nibabel
    python - <<EOF
import os, shutil, nnunetv2
d = os.path.join(os.path.dirname(nnunetv2.__file__), 'training', 'nnUNetTrainer', 'variants', 'delta')
os.makedirs(d, exist_ok=True); open(os.path.join(d, '__init__.py'), 'a').close()
shutil.copy('$HERE/nnUNetTrainerDelta.py', d)
import torch, cc3d, skimage, networkx, nibabel
from nnunetv2.training.nnUNetTrainer.variants.delta.nnUNetTrainerDelta import nnUNetTrainerDelta
print('venv ok: torch', torch.__version__)
EOF
    touch "$VENV/.delta_ok"
    deactivate
  fi
fi

# ---------------------------------------------------------------- 5. ImageCAS-X names (internet: login node only)
# Not guarded on test.txt: an interrupted fetch leaves the file lists but not all segmentations,
# which silently dropped 17 of 80 open cases in Round 5. fetch_icx.py skips files already present
# and exits non-zero unless all 800 segmentations are there.
n_icx=$(find "$SCRATCH/delta_icx/ImageCAS-X_dataset/segmentations" -name "*.nii.gz" 2>/dev/null | wc -l)
if (( n_icx < 800 )); then
  if [[ "$CMD" == dryrun ]]; then say "(dryrun) would fetch ImageCAS-X into $SCRATCH/delta_icx ($n_icx/800 present)"; else
    "$VENV/bin/python" "$HERE/fetch_icx.py" "$SCRATCH/delta_icx"; fi
fi

# ---------------------------------------------------------------- 6. budget
USED="$(used_seconds)"
LEFT=$((BUDGET_S - USED))
(( LEFT > 3600 )) || die "GPU budget exhausted: $((USED / 60)) min used of $((BUDGET_S / 60)). ./delta collect for partial results."
CAP=$BUDGET_S; [[ "$MODE" == atlas ]] && CAP=$((10 * 3600))   # inference only: 10 h is ample for 80 cases
WALL=$(( LEFT < CAP ? LEFT : CAP ))
WALL_HMS="$(printf '%02d:%02d:00' $((WALL / 3600)) $(((WALL % 3600) / 60)))"

# ---------------------------------------------------------------- 7. account
# The project's only Trillium allocation (trillium/README.md). ACCOUNT=... overrides.
ACCOUNT="${ACCOUNT:-def-aso22}"
say "account: $ACCOUNT   walltime: $WALL_HMS (budget left $((LEFT / 60)) min)"

# ---------------------------------------------------------------- 8. job script
cp "$HERE"/pipeline.py "$HERE"/deltalib.py "$HERE"/layout.py "$HERE"/icx_test_split.json "$HERE"/icx_open_strata.json "$WORK/code/"
# A sealed list published by the master (Atlas) takes precedence over Delta's proposed split.
SEALED_LIST=""
for f in "$ATLAS_HERE/sealed_test.json" "$(dirname "$HERE")/sealed_test.json" "$ATLAS_W/results/sealed_test.json" "$ATLAS_HERE/sealed_test.txt" "$ATLAS_W/results/sealed_test.txt"; do
  if [[ -f "$f" ]]; then SEALED_LIST="$f"; break; fi
done
say "sealed test list: ${SEALED_LIST:-$HERE/icx_test_split.json, the split Delta published, as no master list was found}"
if [[ "$MODE" == atlas && "$CMD" != dryrun ]]; then
  # nnU-Net must be able to import Atlas's trainer class to rebuild its network
  [[ -f "$ATLAS_HERE/lib/atlas_trainers.py" ]] || die "Atlas's trainer file not found at $ATLAS_HERE/lib/atlas_trainers.py"
  "$VENV/bin/python" - "$ATLAS_HERE/lib/atlas_trainers.py" <<'PYEOF'
import os, shutil, sys, nnunetv2
d = os.path.join(os.path.dirname(nnunetv2.__file__), 'training', 'nnUNetTrainer', 'variants', 'delta')
os.makedirs(d, exist_ok=True); open(os.path.join(d, '__init__.py'), 'a').close()
shutil.copy(sys.argv[1], os.path.join(d, 'atlas_trainers.py'))
PYEOF
fi
JOB="$WORK/job.sh"
cat > "$JOB" <<EOF
#!/bin/bash
#SBATCH --job-name=$JOBNAME
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --time=$WALL_HMS
#SBATCH --output=$WORK/logs/%x_%j.out
#SBATCH --account=$ACCOUNT
set -euo pipefail
module purge
module load $PY_MODULES $GPU_MODULES
source "$VENV/bin/activate"
export DELTA_WORK="$WORK" DELTA_CASES="$CASES_DIR" DELTA_ICX="$SCRATCH/delta_icx" DELTA_DEVICE=cuda
export DELTA_MODE="$MODE" DELTA_MODEL_DIR="$ATLAS_MODEL_DIR" DELTA_CHK="$ATLAS_CHK" DELTA_SEALED_LIST="$SEALED_LIST"
export DELTA_NPROC=\${SLURM_CPUS_ON_NODE:-24}; DELTA_NPROC=\$(( DELTA_NPROC > 4 ? DELTA_NPROC - 4 : 1 ))
export DELTA_JOB_END=\$(( \$(date +%s) + $WALL - 900 ))
export nnUNet_raw="$WORK/nnUNet_raw" nnUNet_preprocessed="$WORK/nnUNet_preprocessed" nnUNet_results="$WORK/nnUNet_results"
export nnUNet_n_proc_DA=\$(( DELTA_NPROC > 12 ? 12 : DELTA_NPROC ))
export OMP_NUM_THREADS=1
nvidia-smi || true
cd "$WORK"
python "$WORK/code/pipeline.py" all
touch "$WORK/.done_summary"
echo "DELTA DONE: results in $WORK/results (run ./delta again on the login node to copy them back)"
EOF
chmod +x "$JOB"

if [[ "$CMD" == dryrun ]]; then say "(dryrun) job script:"; cat "$JOB"; exit 0; fi

cd "$WORK"
JID="$(sbatch --parsable "$JOB")"
echo "$JID" >> "$LEDGER"
say "submitted job $JID ($JOBNAME, 1 x H100, $WALL_HMS)."
say "progress: ./delta status    log: $WORK/logs/${JOBNAME}_$JID.out"
say "when it finishes, run ./delta again: results land in $HERE/results/"
